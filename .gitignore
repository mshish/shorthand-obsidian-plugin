node_modules/

# The compiled bundle (~6.9MB — it bundles the Claude Agent SDK). Ship it via a GitHub
# release, never git. A fresh clone therefore has no main.js: run `npm run build` before
# enabling the plugin in Obsidian.
main.js

# Exclude sourcemaps
*.map

# Obsidian writes plugin settings here when this repo is cloned into a vault. With the clone
# outside the vault, settings live in the vault's plugin folder instead and never appear here.
data.json
data.json.bak

# Editors
.vscode
.idea
*.iml

.DS_Store

# Local git worktrees (SDD scratch)
.worktrees/
