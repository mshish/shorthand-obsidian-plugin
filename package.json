{
  "name": "obsidian-shorthand",
  "version": "0.5.0",
  "description": "Capture Shorthand transcripts and maintain an AI-owned meeting-note summary.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Michael Sciscenti",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "shorthand-core": "github:mshish/shorthand-core#0.18.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "22.14.0",
    "esbuild": "0.25.9",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
